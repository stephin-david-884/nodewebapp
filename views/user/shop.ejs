<%- include("../../views/partials/user/header") %>
<%
  function buildQuery(newParams) {
    const currentParams = {
      category: selectedCategory,
      brand: selectedBrand,
      gt: priceRange?.gt,
      lt: priceRange?.lt,
      sortBy: sortBy,
      query: query
    };
    return Object.entries({ ...currentParams, ...newParams })
      .filter(([key, value]) => value !== null && value !== undefined && value !== '')
      .map(([key, value]) => `${key}=${value}`)
      .join('&');
  }
%>

<style>
  :root {
    --shop-primary: #111827;
    --shop-accent: #2563eb;
    --shop-accent-hover: #1d4ed8;
    --shop-bg: #f8fafc;
    --shop-card-bg: #ffffff;
    --shop-border: #e2e8f0;
    --shop-text: #1e293b;
    --shop-text-muted: #64748b;
  }

  .shop-page-wrapper {
    background-color: var(--shop-bg);
    min-height: 85vh;
    padding-bottom: 3rem;
  }

  /* Breadcrumb */
  .shop-breadcrumb {
    padding: 1rem 0;
    font-size: 0.9rem;
    color: var(--shop-text-muted);
  }
  .shop-breadcrumb a {
    color: var(--shop-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .shop-breadcrumb a:hover {
    color: var(--shop-accent);
  }
  .shop-breadcrumb span {
    margin: 0 0.4rem;
  }

  /* Topbar */
  .shop-topbar-card {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid var(--shop-border);
    padding: 1rem 1.25rem;
    box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    margin-bottom: 1.5rem;
  }

  .shop-search-input-group {
    background: #f1f5f9;
    border-radius: 30px;
    padding: 0.25rem 0.25rem 0.25rem 1rem;
    border: 1px solid transparent;
    transition: all 0.2s ease;
  }

  .shop-search-input-group:focus-within {
    background: #ffffff;
    border-color: var(--shop-accent);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
  }

  .shop-search-input {
    border: none;
    background: transparent;
    font-size: 0.9rem;
    outline: none;
    color: var(--shop-text);
    width: 100%;
  }

  .shop-search-btn {
    background: var(--shop-primary);
    color: #ffffff;
    border: none;
    border-radius: 25px;
    padding: 0.45rem 1.25rem;
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .shop-search-btn:hover {
    background: var(--shop-accent);
  }

  .shop-sort-select {
    border-radius: 10px;
    border: 1px solid var(--shop-border);
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    color: var(--shop-text);
    background-color: #ffffff;
    outline: none;
    cursor: pointer;
    font-weight: 500;
  }
  .shop-sort-select:focus {
    border-color: var(--shop-accent);
  }

  /* Sidebar Filters */
  .shop-sidebar {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid var(--shop-border);
    padding: 1.25rem;
    box-shadow: 0 4px 15px rgba(0,0,0,0.02);
  }

  .filter-group {
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid #f1f5f9;
  }
  .filter-group:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .filter-heading {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--shop-primary);
    margin-bottom: 0.85rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .filter-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .filter-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.45rem 0.75rem;
    border-radius: 8px;
    color: var(--shop-text);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .filter-link:hover {
    background-color: #f1f5f9;
    color: var(--shop-accent);
  }

  .filter-link.active {
    background-color: #eff6ff;
    color: var(--shop-accent);
    font-weight: 700;
  }

  .price-chip-grid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .price-chip-btn {
    display: block;
    width: 100%;
    text-align: center;
    padding: 0.5rem 0.75rem;
    border-radius: 20px;
    border: 1px solid var(--shop-border);
    background: #ffffff;
    color: var(--shop-text);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .price-chip-btn:hover, .price-chip-btn.active {
    background: var(--shop-primary);
    color: #ffffff;
    border-color: var(--shop-primary);
  }

  /* Product Card Grid */
  .product-card-modern {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid var(--shop-border);
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    height: 100%;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .product-card-modern:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 25px rgba(0, 0, 0, 0.08);
    border-color: #cbd5e1;
  }

  .product-image-container {
    position: relative;
    width: 100%;
    padding-top: 100%; /* 1:1 Aspect Ratio */
    background-color: #f8fafc;
    overflow: hidden;
  }

  .product-image-container img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .product-card-modern:hover .product-image-container img {
    transform: scale(1.06);
  }

  .wishlist-floating-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 5;
    box-shadow: 0 3px 10px rgba(0,0,0,0.12);
    transition: all 0.2s ease;
  }

  .wishlist-floating-btn:hover {
    transform: scale(1.12);
    background: #ffffff;
  }

  .discount-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: #ef4444;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.25rem 0.6rem;
    border-radius: 12px;
    z-index: 5;
    letter-spacing: 0.5px;
  }

  .product-card-body {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
  }

  .product-brand-tag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--shop-text-muted);
    margin-bottom: 0.25rem;
  }

  .product-title-link {
    color: var(--shop-primary);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    line-height: 1.35;
    margin-bottom: 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.2s ease;
  }

  .product-title-link:hover {
    color: var(--shop-accent);
  }

  .product-price-box {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: auto;
  }

  .sale-price {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--shop-primary);
  }

  .regular-price {
    font-size: 0.85rem;
    color: var(--shop-text-muted);
    text-decoration: line-through;
  }

  /* Pagination */
  .shop-pagination .page-link {
    border-radius: 8px;
    margin: 0 3px;
    border: 1px solid var(--shop-border);
    color: var(--shop-text);
    font-weight: 600;
    padding: 0.45rem 0.85rem;
    font-size: 0.9rem;
  }

  .shop-pagination .page-item.active .page-link {
    background-color: var(--shop-primary);
    border-color: var(--shop-primary);
    color: #ffffff;
  }

  /* Mobile Drawer Sidebar */
  @media (max-width: 767.98px) {
    #mobileSidebar {
      position: fixed;
      top: 0;
      left: -100%;
      height: 100vh;
      width: 82%;
      max-width: 320px;
      background: #ffffff;
      z-index: 9999;
      transition: left 0.3s ease;
      overflow-y: auto;
      padding: 1.25rem;
      box-shadow: 4px 0 20px rgba(0, 0, 0, 0.2);
    }

    #mobileSidebar.active {
      left: 0;
    }

    #sidebarBackdrop {
      display: none;
      position: fixed;
      top: 0; 
      left: 0;
      width: 100%;
      height: 100vh;
      background: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(2px);
      z-index: 9998;
    }

    #sidebarBackdrop.active {
      display: block;
    }
  }
</style>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<main class="main shop-page-wrapper">
  <!-- Breadcrumb -->
  <div class="container">
    <div class="shop-breadcrumb">
      <a href="/"><i class="fas fa-home me-1"></i> Home</a>
      <span>/</span>
      <strong class="text-dark">Shop Catalog</strong>
    </div>

    <!-- Top Bar Header Section -->
    <div class="shop-topbar-card">
      <div class="row g-3 align-items-center justify-content-between">
        
        <!-- Search Bar (Expanded width) -->
        <div class="col-md-7 col-lg-8">
          <form action="/shop" method="GET" class="w-100">
            <input type="hidden" name="category" value="<%= selectedCategory || '' %>">
            <input type="hidden" name="brand" value="<%= selectedBrand || '' %>">
            <input type="hidden" name="gt" value="<%= priceRange?.gt || '' %>">
            <input type="hidden" name="lt" value="<%= priceRange?.lt || '' %>">
            <input type="hidden" name="sortBy" value="<%= sortBy || '' %>">

            <div class="d-flex align-items-center shop-search-input-group w-100">
              <i class="fas fa-search text-muted me-2 ms-1"></i>
              <input 
                type="text" 
                name="query" 
                placeholder="Search products, brands, categories..." 
                class="shop-search-input flex-grow-1" 
                value="<%= query || '' %>"
              />
              <button type="submit" class="shop-search-btn px-4">Search</button>
            </div>
          </form>
        </div>

        <!-- Right Side: Mobile Filter Trigger & Sort Dropdown -->
        <div class="col-md-5 col-lg-4 d-flex align-items-center justify-content-md-end gap-2">
          
          <!-- Mobile Filter Button (Visible on mobile) -->
          <button id="mobileFilterBtn" class="btn btn-outline-dark d-md-none rounded-pill px-3 py-2 fw-semibold">
            <i class="fas fa-filter me-1"></i> Filters
          </button>

          <!-- Sort Form Dropdown -->
          <form method="GET" id="sortForm" class="d-flex align-items-center ms-auto ms-md-0">
            <input type="hidden" name="category" value="<%= selectedCategory || '' %>">
            <input type="hidden" name="brand" value="<%= selectedBrand || '' %>">
            <input type="hidden" name="gt" value="<%= priceRange?.gt || '' %>">
            <input type="hidden" name="lt" value="<%= priceRange?.lt || '' %>">
            <input type="hidden" name="query" value="<%= query || '' %>">

            <span class="text-muted small me-2 d-none d-sm-inline fw-semibold text-nowrap">Sort By:</span>
            <select name="sortBy" class="shop-sort-select" onchange="document.getElementById('sortForm').submit()">
              <option value="">Default Order</option>
              <option value="lowToHigh" <%= sortBy === 'lowToHigh' ? 'selected' : '' %>>Price: Low to High</option>
              <option value="highToLow" <%= sortBy === 'highToLow' ? 'selected' : '' %>>Price: High to Low</option>
              <option value="aToZ" <%= sortBy === 'aToZ' ? 'selected' : '' %>>Name: A to Z</option>
              <option value="zToA" <%= sortBy === 'zToA' ? 'selected' : '' %>>Name: Z to A</option>
            </select>
          </form>

        </div>
      </div>
    </div>

    <!-- Main Content Layout (Sidebar Filters + Product Grid) -->
    <div class="row g-4">
      
      <!-- Left Sidebar Filters Column -->
      <div class="col-md-4 col-lg-3">
        <aside class="shop-sidebar" id="mobileSidebar">
          
          <!-- Mobile Header (Visible only in mobile drawer) -->
          <div class="d-flex justify-content-between align-items-center d-md-none mb-3 pb-2 border-bottom">
            <h6 class="fw-bold mb-0"><i class="fas fa-filter me-2 text-primary"></i>Filters</h6>
            <button id="closeSidebarBtn" class="btn-close" aria-label="Close"></button>
          </div>

          <!-- Categories Filter Section -->
          <div class="filter-group">
            <div class="filter-heading">
              <span><i class="fas fa-th-large me-2 text-secondary"></i>Categories</span>
            </div>
            <ul class="filter-list">
              <li class="mb-1">
                <a href="/shop?<%= buildQuery({ category: '' }) %>" class="filter-link <%= !selectedCategory ? 'active' : '' %>">
                  <span>All Categories</span>
                  <% if (!selectedCategory) { %><i class="fas fa-check small text-primary"></i><% } %>
                </a>
              </li>
              <% for (let i = 0; i < category.length; i++) { %>
                <% const isCatActive = selectedCategory === category[i]._id.toString(); %>
                <li class="mb-1">
                  <a href="/shop?<%= buildQuery({ category: category[i]._id }) %>" class="filter-link <%= isCatActive ? 'active' : '' %>">
                    <span><%= category[i].name %></span>
                    <% if (isCatActive) { %><i class="fas fa-check small text-primary"></i><% } %>
                  </a>
                </li>
              <% } %>
            </ul>
          </div>

          <!-- Brands Filter Section -->
          <div class="filter-group">
            <div class="filter-heading">
              <span><i class="fas fa-tags me-2 text-secondary"></i>Brands</span>
            </div>
            <ul class="filter-list">
              <li class="mb-1">
                <a href="/shop?<%= buildQuery({ brand: '' }) %>" class="filter-link <%= !selectedBrand ? 'active' : '' %>">
                  <span>All Brands</span>
                  <% if (!selectedBrand) { %><i class="fas fa-check small text-primary"></i><% } %>
                </a>
              </li>
              <% for (let i = 0; i < brand.length; i++) { %>
                <% const isBrandActive = selectedBrand === brand[i].brandName; %>
                <li class="mb-1">
                  <a href="/shop?<%= buildQuery({ brand: brand[i].brandName }) %>" class="filter-link <%= isBrandActive ? 'active' : '' %>">
                    <span><%= brand[i].brandName %></span>
                    <% if (isBrandActive) { %><i class="fas fa-check small text-primary"></i><% } %>
                  </a>
                </li>
              <% } %>
            </ul>
          </div>

          <!-- Price Filter Section -->
          <div class="filter-group">
            <div class="filter-heading">
              <span><i class="fas fa-rupee-sign me-2 text-secondary"></i>Price Range</span>
            </div>
            <div class="price-chip-grid">
              <a href="/shop?<%= buildQuery({ gt: 0, lt: 500 }) %>" class="price-chip-btn <%= (priceRange?.gt == 0 && priceRange?.lt == 500) ? 'active' : '' %>">
                Under ₹499
              </a>
              <a href="/shop?<%= buildQuery({ gt: 500, lt: 1000 }) %>" class="price-chip-btn <%= (priceRange?.gt == 500 && priceRange?.lt == 1000) ? 'active' : '' %>">
                ₹500 - ₹999
              </a>
              <a href="/shop?<%= buildQuery({ gt: 1000, lt: 1500 }) %>" class="price-chip-btn <%= (priceRange?.gt == 1000 && priceRange?.lt == 1500) ? 'active' : '' %>">
                ₹1000 - ₹1499
              </a>
              <a href="/shop?<%= buildQuery({ gt: 1500, lt: 100000 }) %>" class="price-chip-btn <%= (priceRange?.gt == 1500 && priceRange?.lt == 100000) ? 'active' : '' %>">
                Above ₹1500
              </a>
            </div>
          </div>

          <!-- Clear Filters Section -->
          <div class="pt-2">
            <a href="/shop" class="btn btn-outline-danger w-100 rounded-3 btn-sm fw-semibold">
              <i class="fas fa-undo me-1"></i> Reset All Filters
            </a>
          </div>

        </aside>
      </div>

      <!-- Right Product Cards Grid Column -->
      <div class="col-md-8 col-lg-9">
        <% if (products && products.length > 0) { %>
          <div class="row g-3 g-md-4">
            <% for (let i = 0; i < products.length; i++) { 
                 const isWishlisted = wishlistProductIds.includes(products[i]._id.toString());
                 const discountPercent = (products[i].regularPrice > products[i].salePrice) 
                   ? Math.round(((products[i].regularPrice - products[i].salePrice) / products[i].regularPrice) * 100)
                   : 0;
            %>
              <div class="col-6 col-sm-6 col-lg-4">
                <div class="product-card-modern">
                  
                  <!-- Floating Wishlist Button -->
                  <span 
                    class="wishlist-floating-btn" 
                    onclick="addToWishlist('<%= products[i]._id %>')"
                    title="Add to Wishlist"
                  >
                    <i class="<%= isWishlisted ? 'fas' : 'far' %> fa-heart"
                       style="color: <%= isWishlisted ? '#ef4444' : '#64748b' %>; font-size: 1.1rem;"></i>
                  </span>

                  <!-- Discount Tag -->
                  <% if (discountPercent > 0) { %>
                    <span class="discount-badge"><%= discountPercent %>% OFF</span>
                  <% } %>

                  <!-- Product Image Link -->
                  <a href="/productDetails?id=<%= products[i]._id %>" class="product-image-container d-block">
                    <img 
                      src="<%= (products[i].productImage && products[i].productImage.length > 0) ? products[i].productImage[0] : '/img/default-product.png' %>" 
                      alt="<%= products[i].productName %>" 
                      loading="lazy"
                    />
                  </a>

                  <!-- Product Card Body -->
                  <div class="product-card-body">
                    <div>
                      <div class="product-brand-tag"><%= products[i].brand || 'Brand' %></div>
                      <a href="/productDetails?id=<%= products[i]._id %>" class="product-title-link">
                        <%= products[i].productName %>
                      </a>
                    </div>

                    <div class="product-price-box">
                      <span class="sale-price">₹<%= products[i].salePrice ? products[i].salePrice.toLocaleString('en-IN') : '0' %></span>
                      <% if (products[i].regularPrice && products[i].regularPrice > products[i].salePrice) { %>
                        <span class="regular-price">₹<%= products[i].regularPrice.toLocaleString('en-IN') %></span>
                      <% } %>
                    </div>
                  </div>

                </div>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <!-- Empty State -->
          <div class="bg-white rounded-4 p-5 text-center border shadow-sm my-4">
            <i class="fas fa-search fa-3x text-muted opacity-50 mb-3"></i>
            <h5 class="fw-bold text-dark">No Products Found</h5>
            <p class="text-muted small mb-3">We couldn't find any products matching your search or filters.</p>
            <a href="/shop" class="btn btn-primary btn-sm rounded-pill px-4">Reset Filters</a>
          </div>
        <% } %>

        <!-- Pagination Section -->
        <% if (totalPages > 1) { %>
          <div class="d-flex justify-content-center mt-4 pt-2">
            <nav aria-label="Product pagination">
              <ul class="pagination shop-pagination mb-0">
                <% if (currentPage > 1) { %>
                  <li class="page-item">
                    <a class="page-link" href="/shop?<%= buildQuery({ page: currentPage - 1 }) %>">&laquo; Prev</a>
                  </li>
                <% } %>

                <% for (let i = 1; i <= totalPages; i++) { %>
                  <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                    <a class="page-link" href="/shop?<%= buildQuery({ page: i }) %>"><%= i %></a>
                  </li>
                <% } %>

                <% if (currentPage < totalPages) { %>
                  <li class="page-item">
                    <a class="page-link" href="/shop?<%= buildQuery({ page: currentPage + 1 }) %>">Next &raquo;</a>
                  </li>
                <% } %>
              </ul>
            </nav>
          </div>
        <% } %>

      </div> <!-- End Product Grid Column -->

    </div> <!-- End Row -->
  </div> <!-- End Container -->
</main>

<div id="sidebarBackdrop" class="d-md-none"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
  function addToWishlist(productId) {
    $.ajax({
      url: '/addToWishlist',
      method: 'POST',
      data: { productId: productId },
      success: (response) => {
        if (response.status) {
          Swal.fire({
            title: 'Added to wishlist',
            text: 'The product has been added to your wishlist',
            icon: 'success',
            timer: 2000
          });

          // Toggle icon to filled red heart
          const icon = document.querySelector(`.wishlist-floating-btn[onclick="addToWishlist('${productId}')"] i`);
          if (icon) {
            icon.classList.remove('far');
            icon.classList.add('fas');
            icon.style.color = '#ef4444';
          }
        } else {
          Swal.fire({
            title: 'Already in wishlist',
            text: response.message,
            icon: 'info',
            timer: 2000
          });
        }
      },
      error: (error) => {
        Swal.fire({
          title: 'Error',
          text: 'There was an error adding the product to your wishlist',
          icon: 'error',
          timer: 2000
        });
      }
    });
  }
</script>

<script>
  const mobileFilterBtn = document.getElementById("mobileFilterBtn");
  const sidebar = document.getElementById("mobileSidebar");
  const closeBtn = document.getElementById("closeSidebarBtn");
  const backdrop = document.getElementById("sidebarBackdrop");

  mobileFilterBtn?.addEventListener("click", () => {
    sidebar.classList.add("active");
    backdrop.classList.add("active");
  });

  closeBtn?.addEventListener("click", () => {
    sidebar.classList.remove("active");
    backdrop.classList.remove("active");
  });

  backdrop?.addEventListener("click", () => {
    sidebar.classList.remove("active");
    backdrop.classList.remove("active");
  });
</script>

<%- include("../../views/partials/user/footer") %>
