<%- include("../../views/partials/user/header") %>

<style>
  :root {
    --cart-primary: #111827;
    --cart-accent: #2563eb;
    --cart-accent-hover: #1d4ed8;
    --cart-bg: #f8fafc;
    --cart-card-bg: #ffffff;
    --cart-border: #e2e8f0;
    --cart-text: #1e293b;
    --cart-text-muted: #64748b;
  }

  .cart-page-wrapper {
    background-color: var(--cart-bg);
    min-height: 85vh;
    padding-bottom: 3rem;
  }

  .cart-breadcrumb {
    padding: 1rem 0;
    font-size: 0.9rem;
    color: var(--cart-text-muted);
  }

  .cart-breadcrumb a {
    color: var(--cart-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .cart-breadcrumb a:hover {
    color: var(--cart-accent);
  }

  .cart-breadcrumb span {
    margin: 0 0.4rem;
  }

  .cart-card {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid var(--cart-border);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  .cart-card-header {
    background: #ffffff;
    border-bottom: 1px solid var(--cart-border);
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-card-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--cart-primary);
    margin: 0;
  }

  .cart-item-image {
    width: 90px;
    height: 90px;
    object-fit: cover;
    border-radius: 12px;
    background-color: #f1f5f9;
    border: 1px solid var(--cart-border);
  }

  .size-btn-chip {
    border: 1px solid var(--cart-border);
    background-color: #ffffff;
    color: var(--cart-text);
    padding: 0.25rem 0.65rem;
    font-size: 0.78rem;
    font-weight: 600;
    border-radius: 6px;
    transition: all 0.2s ease;
  }

  .size-btn-chip:hover {
    background-color: #f1f5f9;
    border-color: #cbd5e1;
  }

  .size-btn-chip.active {
    background-color: var(--cart-primary);
    color: #ffffff;
    border-color: var(--cart-primary);
  }

  .quantity-stepper {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--cart-border);
    border-radius: 10px;
    background-color: #ffffff;
    overflow: hidden;
  }

  .quantity-stepper .btn-step {
    border: none;
    background: transparent;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    color: var(--cart-text);
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .quantity-stepper .btn-step:hover {
    background-color: #f1f5f9;
  }

  .quantity-stepper .quantity-input {
    width: 40px;
    border: none;
    text-align: center;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--cart-primary);
    background: transparent;
    outline: none;
  }

  .btn-remove-item {
    color: #ef4444;
    background: #fef2f2;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-remove-item:hover {
    background: #ef4444;
    color: #ffffff;
    transform: scale(1.05);
  }

  .summary-card {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid var(--cart-border);
    padding: 1.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 0;
    border-bottom: 1px solid #f1f5f9;
    font-size: 0.95rem;
  }

  .summary-row:last-child {
    border-bottom: none;
  }
</style>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<main class="main cart-page-wrapper">
  <!-- Breadcrumb -->
  <div class="container">
    <div class="cart-breadcrumb">
      <a href="/"><i class="fas fa-home me-1"></i> Home</a>
      <span>/</span>
      <a href="/shop">Shop</a>
      <span>/</span>
      <strong class="text-dark">Shopping Cart</strong>
    </div>
  </div>

  <section class="mt-2">
    <div class="container">
      <div class="row g-4">
        
        <!-- Cart Items List Column -->
        <div class="col-lg-8">
          <div class="cart-card">
            <div class="cart-card-header">
              <h5 class="cart-card-title"><i class="fas fa-shopping-cart text-primary me-2"></i>Your Cart Items</h5>
              <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 rounded-pill">
                <%= data ? data.length : 0 %> Item(s)
              </span>
            </div>

            <div class="card-body p-0">
              <% if (data && data.length > 0) { %>
                <div class="table-responsive">
                  <table class="table align-middle mb-0">
                    <thead class="bg-light">
                      <tr class="text-uppercase text-muted small fw-bold">
                        <th class="ps-4" style="width: 45%;">Product Details</th>
                        <th class="text-center" style="width: 20%;">Price</th>
                        <th class="text-center" style="width: 20%;">Quantity</th>
                        <th class="text-end pe-4" style="width: 15%;">Remove</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% var x = 0; %>
                      <% for (let i = 0; i < data.length; i++) { %>
                        <% x += data[i].productDetails[0].salePrice * data[i].quantity; %>
                        <tr id="cartRow<%= i %>">
                          
                          <!-- Product Details Column -->
                          <td class="ps-4 py-3">
                            <div class="d-flex align-items-center">
                              <img 
                                src="<%= data[i].productDetails[0].productImage[0] %>" 
                                alt="<%= data[i].productDetails[0].productName %>" 
                                class="cart-item-image me-3 flex-shrink-0"
                              />
                              <div>
                                <h6 class="fw-bold text-dark mb-1 mb-md-1">
                                  <a href="/productDetails?id=<%= data[i].productDetails[0]._id %>" class="text-dark text-decoration-none">
                                    <%= data[i].productDetails[0].productName %>
                                  </a>
                                </h6>
                                <p class="text-muted small mb-2">
                                  Brand: <strong><%= data[i].productDetails[0].brand %></strong> | 
                                  Size: <span class="badge bg-dark text-white"><%= data[i].size || 'N/A' %></span>
                                </p>

                                <!-- Size Selector Chips -->
                                <div class="size-selector">
                                  <% 
                                    var sizesObject = data[i].productDetails[0].sizes || {}; 
                                    var sizeKeys = Object.keys(sizesObject); 
                                  %>
                                  <small class="d-block text-muted me-1 fw-semibold mb-1" style="font-size: 0.75rem;">Change Size:</small>
                                  <div class="d-flex flex-wrap gap-1">
                                    <% sizeKeys.forEach(size => { 
                                        var availableQty = sizesObject[size];
                                        var isActive = size === data[i].size;
                                        var isOutOfStock = availableQty <= 0;
                                    %>
                                      <button 
                                        type="button"
                                        class="size-btn-chip <%= isActive ? 'active' : '' %>" 
                                        onclick="<%= isOutOfStock ? '' : `updateSize('${data[i].productDetails[0]._id}', '${size}', '${data[i].size}')` %>"
                                        <%= isOutOfStock ? 'disabled style="opacity: 0.5; cursor: not-allowed;"' : '' %>
                                      >
                                        <%= size %>
                                      </button>
                                    <% }) %>
                                  </div>
                                </div>

                              </div>
                            </div>
                          </td>

                          <!-- Price Column -->
                          <td class="text-center py-3">
                            <div class="fw-bold text-dark fs-6">
                              ₹<span id="subTotal<%= i %>"><%= data[i].productDetails[0].salePrice * data[i].quantity %></span>
                            </div>
                            <small class="text-muted small">
                              ₹<span id="price"><%= data[i].productDetails[0].salePrice %></span> / each
                            </small>
                          </td>

                          <!-- Quantity Controls Column -->
                          <td class="text-center py-3">
                            <div class="quantity-stepper">
                              <button 
                                type="button" 
                                class="btn-step"
                                onclick="changeQuantity('<%= data[i].productDetails[0]._id %>', '<%= data[i].quantity %>', -1, '<%= data[i].productDetails[0].salePrice %>', <%= i %>, '<%= data[i].productDetails[0].quantity %>')"
                              >-</button>
                              
                              <input 
                                class="quantity-input" 
                                id="cartProductQuantity<%= i %>" 
                                value="<%= data[i].quantity %>" 
                                type="text" 
                                readonly 
                              />
                              
                              <button 
                                type="button" 
                                class="btn-step"
                                onclick="changeQuantity('<%= data[i].productDetails[0]._id %>', '<%= data[i].quantity %>', 1, '<%= data[i].productDetails[0].salePrice %>', <%= i %>, '<%= data[i].productDetails[0].quantity %>')"
                              >+</button>
                            </div>
                          </td>

                          <!-- Remove Item Action Column -->
                          <td class="text-end pe-4 py-3">
                            <a 
                              href="#" 
                              class="btn-remove-item" 
                              title="Remove item"
                              onclick="confirmRemove('<%= data[i].productDetails[0]._id %>', '<%= data[i].size %>', <%= i %>)"
                            >
                              <i class="fas fa-trash-alt"></i>
                            </a>
                          </td>

                        </tr>
                      <% } %>
                    </tbody>
                  </table>
                </div>
              <% } else { %>
                <!-- Empty Cart State -->
                <div class="text-center py-5">
                  <i class="fas fa-shopping-basket fa-3x text-muted opacity-50 mb-3"></i>
                  <h5 class="fw-bold text-dark mb-1">Your Shopping Cart is Empty</h5>
                  <p class="text-muted small mb-4">Looks like you haven't added any products to your cart yet.</p>
                  <a href="/shop" class="btn btn-primary rounded-pill px-4">Continue Shopping</a>
                </div>
              <% } %>
              <input type="hidden" id="totalabc" value="<%= x %>">
            </div>
          </div>
        </div>

        <!-- Order Summary & Checkout Column -->
        <div class="col-lg-4">
          <div class="summary-card">
            <h5 class="fw-bold text-dark mb-3"><i class="fas fa-receipt text-success me-2"></i>Order Summary</h5>
            
            <div class="summary-row">
              <span class="text-muted">Delivery Shipping</span>
              <span class="badge bg-success-subtle text-success fw-semibold"><i class="fas fa-shipping-fast me-1"></i> FREE</span>
            </div>

            <div class="summary-row">
              <span class="text-muted">Subtotal Items</span>
              <span class="fw-semibold text-dark"><%= data ? data.length : 0 %> items</span>
            </div>

            <div class="summary-row my-2 pt-2 border-top">
              <span class="fw-bold text-dark fs-6">Grand Total</span>
              <span class="fw-bold text-primary fs-4">
                ₹<span id="total"><%= grandTotal %></span>
              </span>
            </div>

            <% if (data && data.length > 0) { %>
              <a href="/checkout?userId=<%= user._id %>" class="btn btn-primary btn-lg w-100 mt-3 rounded-3 fw-bold fs-6 shadow-sm">
                Proceed To Checkout <i class="fas fa-arrow-right ms-2"></i>
              </a>
            <% } else { %>
              <button class="btn btn-secondary btn-lg w-100 mt-3 rounded-3 fw-bold fs-6" disabled>
                Proceed To Checkout
              </button>
            <% } %>

            <div class="text-center mt-4 pt-3 border-top text-muted small">
              <p class="mb-1"><i class="fas fa-shield-alt text-success me-1"></i> Safe & Secure Checkout</p>
              <p class="mb-0"><i class="fas fa-sync-alt text-primary me-1"></i> 30-Day Easy Returns</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  function changeQuantity(productId, cartQuantity, count, productPrice, i, productQuantity) {
    productQuantity = parseInt(productQuantity);    
    const quantityInput = document.querySelector(`#cartProductQuantity${i}`);
    const subtotalElement = document.querySelector(`#subTotal${i}`);
    const totalElement = document.getElementById('total');

    let currentQuantity = parseInt(quantityInput.value);
    let newQuantity = currentQuantity + count;

    if (newQuantity > 3) {
      Swal.fire({
        title: 'Limit Exceeded!',
        text: 'You can only add up to 3 items to your cart.',
        icon: 'warning',
        timer: 3000
      });
      return;
    }

    if (newQuantity < 1) {
      Swal.fire({
        title: 'Invalid Quantity!',
        text: 'Quantity cannot be less than 1.',
        icon: 'warning',
        timer: 3000
      });
      return;
    }

    if (count === 1 && newQuantity > productQuantity) {
      Swal.fire({
        title: 'Out of Stock!',
        text: 'Not enough stock available.',
        icon: 'error',
        timer: 3000
      });
      return;
    }

    $.ajax({
      url: '/changeQuantity',
      method: 'POST',
      data: {
        productId: productId,
        quantity: newQuantity,
        count: count
      },
      success: (response) => {
        if (response.status) {
          quantityInput.value = newQuantity;
          subtotalElement.innerText = newQuantity * parseInt(productPrice);
          totalElement.innerText = response.grandTotal;
        } else {
          Swal.fire({
            title: 'Oops!',
            text: response.error || 'Something went wrong.',
            icon: 'error',
            timer: 3000
          });
        }
      },
      error: (error) => {
        console.error('Server error:', error);
        Swal.fire({
          title: 'Server Error!',
          text: 'Please try again later.',
          icon: 'error',
          timer: 3000
        });
      }
    });
  }
</script>

<script>
  function confirmRemove(productId, size, index) {
    Swal.fire({
      title: 'Are you sure?',
      text: "Do you want to remove this item from your cart?",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#ef4444',
      cancelButtonColor: '#64748b',
      confirmButtonText: 'Yes, remove it!'
    }).then((result) => {
      if (result.isConfirmed) {
        $.ajax({
          url: '/deleteItem',
          method: 'POST',
          data: { productId, size },
          success: function (response) {
            if (response.status) {
              const row = document.querySelector(`#cartRow${index}`);
              if (row) row.remove();

              const totalElement = document.getElementById("total");
              totalElement.innerText = response.grandTotal;

              Swal.fire('Removed!', 'Item has been removed.', 'success').then(() => {
                location.reload();
              });
            } else {
              Swal.fire('Error!', 'Could not delete item.', 'error');
            }
          },
          error: function (err) {
            console.error(err);
            Swal.fire('Server Error!', 'Try again later.', 'error');
          }
        });
      }
    });
  }
</script>

<script>
  function updateSize(productId, newSize, currentSize) {
    $.ajax({
      url: '/updateCartSize',
      method: 'POST',
      data: { productId, newSize, currentSize },
      success: function (response) {
        if (response.status) {
          Swal.fire({
            icon: 'success',
            title: 'Size Updated!',
            text: 'Product size updated in cart.',
            timer: 2000
          }).then(() => {
            location.reload();
          });
        } else {
          Swal.fire({
            icon: 'error',
            title: 'Failed!',
            text: response.message || 'Could not update size.',
            timer: 3000
          });
        }
      },
      error: function () {
        Swal.fire({
          icon: 'error',
          title: 'Server Error!',
          text: 'Try again later.',
          timer: 3000
        });
      }
    });
  }
</script>

<%- include("../../views/partials/user/footer") %>
